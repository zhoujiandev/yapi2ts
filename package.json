{
    "name": "yapi-ts",
    "displayName": "YAPI TypeScript",
    "description": "Generate TypeScript interfaces and API functions from YAPI. Support custom templates and automatic code generation.",
    "version": "1.3.1",
    "publisher": "zhoujian",
    "repository": {
        "type": "git",
        "url": "https://github.com/zhoujiandev/yapi2ts"
    },
    "bugs": {
        "url": "https://github.com/zhoujiandev/yapi2ts/issues"
    },
    "homepage": "https://github.com/zhoujiandev/yapi2ts#readme",
    "license": "MIT",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "badges": [
        {
            "url": "https://img.shields.io/open-vsx/v/zhoujian/yapi-ts",
            "href": "https://open-vsx.org/extension/zhoujian/yapi-ts",
            "description": "Version"
        },
        {
            "url": "https://img.shields.io/open-vsx/dt/zhoujian/yapi-ts",
            "href": "https://open-vsx.org/extension/zhoujian/yapi-ts",
            "description": "Downloads"
        }
    ],
    "engines": {
        "vscode": "^1.53.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "yapi",
        "yapi2ts",
        "typescript",
        "api",
        "interface",
        "code generator",
        "type generation",
        "yapi typescript"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "yapi2ts",
                    "title": "YAPI TypeScript",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "views": {
            "yapi2ts": [
                {
                    "id": "yapi2ts.explorer",
                    "name": "YAPI Interface Explorer",
                    "type": "webview",
                    "when": "true"
                }
            ]
        },
        "commands": [
            {
                "command": "yapi2ts.resetTemplates",
                "title": "YAPI TypeScript: Reset Templates",
                "category": "YAPI TypeScript"
            },
            {
                "command": "yapi2ts.clearTokens",
                "title": "YAPI TypeScript: Clear Stored Project Tokens (清除已保存的项目 Token)",
                "category": "YAPI TypeScript"
            }
        ],
        "configuration": {
            "title": "YAPI TypeScript",
            "properties": {
                "yapi2ts.projects": {
                    "type": "array",
                    "description": "YAPI 项目配置列表。每个项目必须包含唯一 id、名称和 yapiUrl。",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "name",
                            "yapiUrl"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "项目在工作区内的唯一标识符，例如：'user-service'"
                            },
                            "name": {
                                "type": "string",
                                "description": "项目显示名称，例如：'用户服务'"
                            },
                            "yapiUrl": {
                                "type": "string",
                                "description": "YAPI 平台的完整接口请求地址，例如：'http://yapi.example.com'"
                            },
                            "projectToken": {
                                "type": "string",
                                "description": "【可选】YAPI 项目 Token。如果在工作区配置中填写此字段，可能会通过 Git 泄露到远程仓库。若不填写，系统会安全地提示您在本地输入并加密存储（推荐）。可以通过 YAPI 网页的『项目设置』->『token配置』获取该 Token。"
                            }
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "webpack",
        "compile:check": "tsc --noEmit",
        "compile:full": "pnpm run compile && git add dist/",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "lint": "eslint src --fix",
        "test:ci": "xvfb-run -a vscode-test",
        "lint:check": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vscode-test",
        "prepare": "husky",
        "release:prepare": "node scripts/release-prepare.js"
    },
    "dependencies": {
        "ejs": "^3.1.10",
        "prettier": "^3.6.2"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "1.53.0",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.3",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.2",
        "webpack": "^5.101.3",
        "webpack-cli": "^6.0.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
