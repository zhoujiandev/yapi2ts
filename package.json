{
    "name": "yapi-ts",
    "displayName": "YAPI TypeScript",
    "description": "Generate TypeScript interfaces and API functions from YAPI. Support custom templates and automatic code generation.",
    "version": "1.2.5",
    "publisher": "zhoujian",
    "repository": {
        "type": "git",
        "url": "https://github.com/zhoujiandev/yapi2ts"
    },
    "bugs": {
        "url": "https://github.com/zhoujiandev/yapi2ts/issues"
    },
    "homepage": "https://github.com/zhoujiandev/yapi2ts#readme",
    "license": "MIT",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "badges": [
        {
            "url": "https://img.shields.io/open-vsx/v/zhoujian/yapi-ts",
            "href": "https://open-vsx.org/extension/zhoujian/yapi-ts",
            "description": "Version"
        },
        {
            "url": "https://img.shields.io/open-vsx/dt/zhoujian/yapi-ts",
            "href": "https://open-vsx.org/extension/zhoujian/yapi-ts",
            "description": "Downloads"
        }
    ],
    "engines": {
        "vscode": "^1.50.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "yapi",
        "yapi2ts",
        "typescript",
        "api",
        "interface",
        "code generator",
        "type generation",
        "yapi typescript"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "yapi2ts",
                    "title": "YAPI TypeScript",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "views": {
            "yapi2ts": [
                {
                    "id": "yapi2ts.explorer",
                    "name": "YAPI Interface Explorer",
                    "type": "webview",
                    "when": "true"
                }
            ]
        },
        "commands": [
            {
                "command": "yapi2ts.resetTemplates",
                "title": "YAPI TypeScript: Reset Templates",
                "category": "YAPI TypeScript"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "webpack",
        "compile:check": "tsc --noEmit",
        "compile:full": "pnpm run compile && git add dist/",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "lint": "eslint src --fix",
        "test:ci": "xvfb-run -a vscode-test",
        "lint:check": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vscode-test",
        "prepare": "husky"
    },
    "dependencies": {
        "ejs": "^3.1.10",
        "prettier": "^3.6.2"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "1.50.0",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.3",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.2",
        "webpack": "^5.101.3",
        "webpack-cli": "^6.0.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
